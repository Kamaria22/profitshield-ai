{
  "name": "Self-Heal Watchdog (30min)",
  "description": "Every 30 minutes: checks Shopify tokens, webhooks, queue health, secrets, Stripe. Auto-heals operational issues. Logs to SelfHealingEvent + AuditLog.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-03-03T02:57:48.962000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "self_heal_watchdog_30min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "selfHeal",
            "args": {
              "action": "run_watchdog"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "selfHeal"
  }
}